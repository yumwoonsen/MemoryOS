# Deterministic mode is local, free, and does not require credentials.
MEMORYOS_PROVIDER=deterministic

# Recommended hosted provider for the current prototype. Free-tier input may be
# used by the provider to improve its products; use only synthetic telemetry here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_V2_MAX_OUTPUT_TOKENS=4000

# Optional Groq live provider. Keep the real key on the backend only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Keep this at 2500 for the prototype free-tier envelope. Raise it after upgrading
# provider capacity; restart the backend after changing it.
GROQ_V2_MAX_OUTPUT_TOKENS=2500

# Optional OpenAI live provider. Keep the real key in .env and out of source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional shared secret for a trusted server-side frontend proxy. When set, protected
# data-bearing POST routes and v2 Studio trace reads require the X-MemoryOS-Proxy-Token header.
# Never place this value in browser code.
MEMORYOS_PROXY_TOKEN=

# Optional evaluation-only price assumptions, in USD per million tokens.
OPENAI_INPUT_COST_PER_MILLION=1.0
OPENAI_OUTPUT_COST_PER_MILLION=6.0

# Optional comma-separated browser origins. These four local origins are allowed by default.
# MEMORYOS_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

