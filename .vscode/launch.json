{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MemoryOS: Run API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--reload"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "MemoryOS: Run Golden Path",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.run_memory",
      "args": [
        "backend/data/funny_memory.json"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
